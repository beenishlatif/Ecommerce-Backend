# Server
NODE_ENV=development
PORT=5000

# Client — comma-separate multiple allowed origins (e.g. local + Vercel prod URL)
CLIENT_URL=http://localhost:5173

# Optional: override the DNS resolvers Node uses (comma-separated). Defaults
# to 1.1.1.1,8.8.8.8 if left unset — helps when the host's default DNS
# resolution is broken or blocked.
DNS_SERVERS=1.1.1.1,8.8.8.8

# Database
MONGO_URI=mongodb+srv://beenish:beenish123@cluster0.yilyakn.mongodb.net/ecommerce

# Auth
JWT_SECRET=Secret123
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# Initial admin seed (server-side only, never exposed to client)
ADMIN_EMAIL=beenishlatif1026@gmail.com
ADMIN_PASSWORD=Zx123456@
ADMIN_NAME=Store Admin

# Payment provider placeholders (fill in real credentials later)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
CARD_GATEWAY_API_KEY=
CARD_GATEWAY_SECRET=
